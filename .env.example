# Server only. Copy to .env and supply your own key. Never use a VITE_ prefix.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Fixture mode is always labelled; strict is the default.
DECISION_MODE=strict
# Supply account-confirmed pricing for a cost projection; unset means unknown.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=
PORT=8787
# Render production-only access gate. Never commit actual invite passwords.
# PLAYTEST_INVITES={"friend-name":"a-unique-random-password-at-least-16-characters"}
# PLAYTEST_COOKIE_SECRET=at-least-32-random-characters
# PUBLIC_ORIGIN=https://your-custom-domain.example
# Render's RENDER_EXTERNAL_URL is used automatically if PUBLIC_ORIGIN is unset.
# Optional public donation page; rebuild after changing. Blank hides the callout.
VITE_SUPPORT_URL=https://ko-fi.com/thepolyglotprogrammer

# Managed invites / owner console. Enable all three together for local testing.
# ACCESS_DB_PATH=./private-data/access.sqlite
# ADMIN_TOKEN=generate-a-random-owner-token-of-at-least-32-characters
# PUBLIC_ORIGIN=http://127.0.0.1:8787
# Durable aggregate monthly token-accounting ceiling (100M ~= $4.20 at $0.042/M).
# Unknown requests retain conservative reservations; this is not an invoice cap.
MONTHLY_INPUT_TOKEN_LIMIT=100000000
# Existing PLAYTEST_INVITES import once into SQLite. Use {} for a new installation.
# After migration, manage invites at /admin; environment edits no longer change invites.
